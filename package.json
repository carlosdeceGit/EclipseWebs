{
  "name": "eclipsewebs",
  "version": "0.1.0",
  "private": true,
  "description": "Red multidominio de guías del eclipse solar total del 2 de agosto de 2027 en el sur de España",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-eclipse.ts",
    "check:scope": "tsx scripts/check-tenant-scope.ts",
