# Copia este archivo a .env.local y rellena lo que necesites.
# El proyecto arranca y compila sin ninguna de estas variables: sin base de datos
# el directorio y los clasificados salen vacíos, y sin AdSense los huecos
# publicitarios no se dibujan en absoluto.

# --- Base de datos (Supabase) -----------------------------------------------
# La anon key es pública y va al navegador; está limitada por las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service role key salta RLS. Solo servidor y agentes. Nunca con prefijo
# NEXT_PUBLIC_, o acabaría en el bundle del navegador.
#
# Se copia del panel de Supabase: Project Settings → API Keys → service_role.
# La necesitan tres cosas: el alta desde /publicar, el panel de moderación y los
# agentes. Sin ella la web funciona, pero el directorio se queda vacío y /admin
# lo dice en pantalla en vez de fallar.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de moderación ----------------------------------------------------
# Contraseña de /admin. Mientras esté vacía, /admin devuelve 404: el panel no
# existe, que es más discreto que enseñar un formulario de login a quien pase.
#
# Es una contraseña única y no un sistema de cuentas porque hoy modera una sola
# persona. Que sea larga: es lo único que separa a cualquiera de aprobar
# anuncios, y el panel escribe con la service role.
ADMIN_PASSWORD=

# --- Publicidad -------------------------------------------------------------
# Pasos completos de activación: docs/activar-adsense.md
#
# ID de cliente de AdSense (ca-pub-XXXXXXXXXXXXXXXX). Mientras esté vacío, /ads.txt
# devuelve 404 y no hay publicidad de ninguna clase.
#
# Ponerlo SOLO a él es seguro y es lo que toca durante la revisión de Google: hace
# que /ads.txt publique el identificador —que es como se verifica la propiedad del
# dominio— sin cargar nada en el navegador, sin cookies de terceros y sin preguntar
# al visitante. El banner de consentimiento y el script de Google esperan a que
# exista además algún ID de bloque.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# IDs de cada bloque, del panel de AdSense. Un hueco sin ID no se dibuja: no hay
# recuadro vacío ni altura reservada, así que se pueden activar de uno en uno.
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# Quién pregunta por las cookies. Vacío = nuestro banner es la barrera y no se
# carga nada de Google sin un sí explícito (lo más estricto, y el valor seguro).
# "google" = el CMP certificado de Google es la única pregunta y su script se carga
# desde el principio, porque el mensaje viaja dentro de él.
#
# Solo poner "google" cuando el mensaje de GDPR esté creado Y PUBLICADO para el
# dominio en AdSense → Privacidad y mensajes, con el formato de TRES opciones.
# Si el mensaje falla o se despublica, se vacía esta variable y se redespliega.
NEXT_PUBLIC_CMP=

# Líneas adicionales de ads.txt, separadas por ';' o por saltos de línea. Solo
# hace falta cuando entre una segunda red (Ezoic, Mediavine) junto a AdSense.
ADS_TXT_EXTRA=

# --- Agentes ----------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
